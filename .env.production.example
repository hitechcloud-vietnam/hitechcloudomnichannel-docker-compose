# =============================================================================
# HiTechCloudOmnichannel — cấu hình production / production configuration
# =============================================================================
# Cách dùng / Usage:
#   cp .env.production.example .env && chmod 600 .env     (hoặc chạy scripts/install.sh)
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d
#
# Quy ước / Conventions:
#   [BẮT BUỘC / REQUIRED]  phải có giá trị / must have a value
#   [TUỲ CHỌN / OPTIONAL]  để nguyên dòng bị comment (#) nếu không dùng.
#                          KHÔNG để "KEY=" rỗng: nhiều biến số sẽ bị đọc thành 0
#                          và làm service không khởi động được.
#                          Leave the line commented out when unused. Do NOT
#                          leave "KEY=" empty: numeric settings would parse an
#                          empty string as 0 and fail validation.
#   Không dùng ký tự "$" trong giá trị (Compose sẽ hiểu là biến).
#   Never use "$" in values (Compose would interpolate it).
#
# Sinh secret / Generating secrets:
#   openssl rand -base64 32   -> BETTER_AUTH_SECRET
#   openssl rand -hex 32      -> ENCRYPTION_KEY, REALTIME_BROADCAST_SECRET,
#                                JAVASCRIPT_EXECUTOR_TOKEN
#   openssl rand -hex 24      -> POSTGRES_PASSWORD, REDIS_PASSWORD,
#                                S3_SECRET_ACCESS_KEY
#   (hex = an toàn khi nằm trong URL / safe inside connection URLs)
#
# Nguồn (platform repo) / Sources: apps/*/src/env.ts, packages/*/src/keys.ts,
# .env.example of github.com/hitechcloud-vietnam/HiTechCloudOmnichannel.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 1. Triển khai / Deployment (Docker Compose, Caddy)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Tên project Compose (tiền tố của volume, network). Đừng đổi sau
# khi đã cài: đổi tên = volume mới, rỗng.
# [REQUIRED] Compose project name (prefix of volumes/networks). Do not change
# after the first install: a new name means new, empty volumes.
COMPOSE_PROJECT_NAME=hitechcloudomnichannel

# [TUỲ CHỌN] Bật thêm service theo profile, ví dụ "mcp" để chạy MCP server.
# [OPTIONAL] Extra compose profiles, e.g. "mcp" to run the MCP server.
# COMPOSE_PROFILES=mcp

# [BẮT BUỘC] Tag image trên ghcr.io: "main" (mỗi lần push main) hoặc "X.Y.Z"
# (mỗi git tag vX.Y.Z — image tag KHÔNG có chữ "v"). Production nên ghim X.Y.Z.
# [REQUIRED] Image tag: "main" (every push to main) or "X.Y.Z" (every git tag
# vX.Y.Z — the image tag has NO "v" prefix). Pin X.Y.Z for production.
IMAGE_TAG=main

# [BẮT BUỘC] Tên miền của ứng dụng (không có https://). DNS A/AAAA phải trỏ về server.
# [REQUIRED] Public app host name (no scheme). DNS A/AAAA must point here.
DOMAIN=app.example.com

# [BẮT BUỘC] Tên miền cho object storage (S3 API của RustFS). Trình duyệt dùng
# trực tiếp các URL presigned trên tên miền này để upload / download file.
# [REQUIRED] Host for the S3 API (RustFS). Browsers use presigned URLs on it
# for uploads/downloads.
S3_DOMAIN=s3.app.example.com

# [BẮT BUỘC] Email nhận thông báo chứng chỉ Let's Encrypt / ZeroSSL.
# [REQUIRED] ACME account e-mail for automatic HTTPS certificates.
ACME_EMAIL=admin@example.com

# [TUỲ CHỌN] Tên miền cho MCP server (cần COMPOSE_PROFILES=mcp và
# caddy/sites-enabled/mcp.caddy).
# [OPTIONAL] MCP server host (needs COMPOSE_PROFILES=mcp and
# caddy/sites-enabled/mcp.caddy).
# MCP_DOMAIN=mcp.app.example.com


# ─────────────────────────────────────────────────────────────────────────────
# 2. Phiên bản & quản trị nền tảng / Edition & platform admin
#    (apps/builder/src/env.ts, packages/business/src/keys.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] community | enterprise | cloud
NEXT_PUBLIC_EDITION=community

# [BẮT BUỘC với enterprise/cloud] License token do HiTechCloud cấp.
# [REQUIRED for enterprise/cloud] Signed license token from the vendor.
# LICENSE_KEY=

# [BẮT BUỘC trên thực tế] Email của tài khoản quản trị nền tảng. Người đăng ký
# bằng email này được vào /admin (cấu hình kênh, credentials nền tảng...).
# [REQUIRED in practice] E-mail of the platform operator; the account signed
# up with it gets the /admin console (platform credentials, channels, ...).
PLATFORM_ADMIN_EMAIL=admin@example.com


# ─────────────────────────────────────────────────────────────────────────────
# 3. Xác thực / Authentication (better-auth — apps/builder/src/env.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] >= 32 ký tự. Sinh: openssl rand -base64 32
# Đổi giá trị này sẽ đăng xuất mọi người dùng.
# [REQUIRED] >= 32 chars. Generate: openssl rand -base64 32
# Changing it signs every user out.
# BETTER_AUTH_URL được tự tính = https://DOMAIN / derived from DOMAIN.
BETTER_AUTH_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 4. Mã hoá dữ liệu / Encryption at rest (packages/encryption/src/keys.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] 64 ký tự hex. Sinh: openssl rand -hex 32
# MẤT KHOÁ NÀY = MẤT toàn bộ secret đã mã hoá (token kênh, API key...).
# Hãy sao lưu .env ở nơi an toàn (scripts/backup.sh có chép .env).
# [REQUIRED] 64 hex chars. Generate: openssl rand -hex 32
# LOSING THIS KEY = LOSING every encrypted secret (channel tokens, API keys).
ENCRYPTION_KEY=

# [TUỲ CHỌN] Dùng khi xoay khoá (key rotation): đặt khoá cũ vào _PREV và đổi ID.
# [OPTIONAL] Key rotation: keep the old key in _PREV and bump the id.
# ENCRYPTION_KEY_ID=default
# ENCRYPTION_KEY_PREV=


# ─────────────────────────────────────────────────────────────────────────────
# 5. PostgreSQL / TimescaleDB (packages/database/src/keys.ts)
#    DATABASE_URL được tự ghép từ các biến dưới / is derived from these.
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Chỉ có hiệu lực lần khởi tạo volume đầu tiên. Đổi về sau phải
# ALTER USER trong Postgres.
# [REQUIRED] Only applied when the volume is first initialised; changing it
# later requires ALTER USER inside Postgres.
POSTGRES_DB=hitechcloudomnichannel
POSTGRES_USER=hitechcloudomnichannel
# Sinh / Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# [TUỲ CHỌN] none | ddl | mod | all
# POSTGRES_LOG_STATEMENT=none
# [TUỲ CHỌN] Log mọi câu SQL của Drizzle / log every Drizzle query.
# DATABASE_DEBUG=false


# ─────────────────────────────────────────────────────────────────────────────
# 6. Redis (BullMQ queues, cache — packages/redis, packages/worker-config)
#    REDIS_URL được tự ghép / is derived: redis://:REDIS_PASSWORD@redis:6379
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Sinh / Generate: openssl rand -hex 24
REDIS_PASSWORD=

# [TUỲ CHỌN] Tách Redis theo vai trò (mỗi biến rơi về REDIS_URL nếu không đặt).
# [OPTIONAL] Split Redis per role (each falls back to REDIS_URL).
# REDIS_CACHE_URL=redis://:password@redis-cache:6379
# REDIS_SEQUENCE_URL=redis://:password@redis-sequence:6379
# REDIS_QUEUE_URL=redis://:password@redis-queue:6379
# REDIS_QUEUE_BULK_URL=redis://:password@redis-queue-bulk:6379


# ─────────────────────────────────────────────────────────────────────────────
# 7. Object storage — RustFS (S3-compatible) (packages/filesystem/src/keys.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Bucket, region và khoá truy cập. Với RustFS đi kèm, cặp khoá này
# cũng là tài khoản root của RustFS.
# [REQUIRED] Bucket/region/credentials. With the bundled RustFS these are also
# its root credentials.
S3_BUCKET=hitechcloudomnichannel
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=hitechcloudomnichannel
# Sinh / Generate: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=

# [TUỲ CHỌN] Dùng S3 bên ngoài (AWS S3, Cloudflare R2, MinIO khác...) thay vì
# RustFS đi kèm. Mặc định: https://S3_DOMAIN.
# [OPTIONAL] Use an external S3 instead of the bundled RustFS.
# Default: https://S3_DOMAIN
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# [TUỲ CHỌN] Tên miền CDN phục vụ file public (mặc định https://DOMAIN/storage/).
# [OPTIONAL] CDN / public storage base URL (default https://DOMAIN/storage/).
# NEXT_PUBLIC_STORAGE_URL=https://cdn.example.com/


# ─────────────────────────────────────────────────────────────────────────────
# 8. Realtime (PartyKit — packages/partysocket-config/src/keys.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] HMAC secret dùng chung giữa builder/worker và realtime, >= 32 ký tự.
# [REQUIRED] Shared HMAC secret builder/worker <-> realtime, >= 32 chars.
# Sinh / Generate: openssl rand -hex 32
REALTIME_BROADCAST_SECRET=

# [TUỲ CHỌN] Bỏ qua typing-event khi không ai đang xem (mặc định true).
# [OPTIONAL] Skip typing broadcasts nobody listens to (default true).
# REALTIME_DELIVERY_GATE=true


# ─────────────────────────────────────────────────────────────────────────────
# 9. JavaScript executor (packages/business/src/javascript-execution/keys.ts,
#    apps/javascript-executor/src/env.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Bearer token giữa worker và executor, >= 32 ký tự.
# [REQUIRED] Bearer token worker <-> executor, >= 32 chars.
# Sinh / Generate: openssl rand -hex 32
JAVASCRIPT_EXECUTOR_TOKEN=

# [TUỲ CHỌN] Số script chạy song song trong executor (giữ <= số CPU cấp cho nó).
# [OPTIONAL] Concurrent isolated-vm executions (keep <= its CPU allocation).
MAX_CONCURRENCY=2


# ─────────────────────────────────────────────────────────────────────────────
# 10. Email / SMTP (packages/mail/src/keys.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Đăng ký tài khoản yêu cầu xác minh email
# (packages/auth/src/server.ts: requireEmailVerification: true) — không có SMTP
# thật thì không ai đăng ký được, kể cả admin.
# [REQUIRED] Sign-up requires e-mail verification — without working SMTP nobody
# (not even the admin) can register.
# Định dạng / Format: smtp[s]://user:pass@host:port  (URL-encode ký tự đặc biệt
# trong mật khẩu / URL-encode special characters in the password)
# Ví dụ / Examples:
#   smtps://no-reply%40example.com:app-password@smtp.gmail.com:465
#   smtp://apikey:SG.xxxxx@smtp.sendgrid.net:587
SMTP_SERVER=smtps://user:password@smtp.example.com:465
SMTP_FROM="HiTechCloudOmnichannel <no-reply@example.com>"


# ─────────────────────────────────────────────────────────────────────────────
# 11. URL công khai nâng cao / Advanced public URLs (apps/builder/src/env.ts)
# ─────────────────────────────────────────────────────────────────────────────
# [TUỲ CHỌN] Broker host trung lập cho OAuth redirect_uri và webhook của
# Meta/TikTok khi dùng white-label custom domain. Mặc định = https://DOMAIN.
# [OPTIONAL] Brand-neutral broker host for OAuth redirect URIs and
# host-validated webhooks. Defaults to https://DOMAIN.
# NEXT_PUBLIC_BROKER_URL=https://broker.example.com

# [TUỲ CHỌN] Pancake chat widget trên trang builder.
# NEXT_PUBLIC_PANCAKE_CHAT_PAGE_ID=


# ─────────────────────────────────────────────────────────────────────────────
# 12. WhatsApp & Messenger nâng cao / advanced channel settings
# ─────────────────────────────────────────────────────────────────────────────
# [TUỲ CHỌN] TURN relay (coturn, use-auth-secret) cho gọi WhatsApp trong app.
# Phải truy cập được qua UDP từ Internet.
# [OPTIONAL] TURN relay for in-app WhatsApp calling (coturn REST/HMAC).
# TURN_URL=turn:turn.example.com:3478
# TURN_STATIC_SECRET=

# [TUỲ CHỌN] Ghi đè callback URI đăng ký với WhatsApp.
# [OPTIONAL] Override the WhatsApp callback URI.
# WHATSAPP_OVERRIDE_CALLBACK_URI=https://app.example.com/integrations/whatsapp/callback

# [TUỲ CHỌN] App id trợ lý tự động dùng cho "return to bot" trên Messenger.
# [OPTIONAL] Messenger handover "return to bot" app id.
# FACEBOOK_BUSINESS_AI_APP_ID=


# ─────────────────────────────────────────────────────────────────────────────
# 13. AI provider mặc định của nền tảng / Platform default AI keys
#     (packages/ai/src/core/factory.ts — chỉ dùng khi workspace không tự cấu
#     hình key / only used when a workspace has no key of its own)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# AI_INTEGRATION_CACHE_TTL_SECONDS=3600


# ─────────────────────────────────────────────────────────────────────────────
# 14. Log / Logging (packages/logger)
# ─────────────────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
# true = đẩy một số log chẩn đoán (có thể chứa dữ liệu khách đã che) lên mức info.
# true = promote opt-in diagnostic lines to info. Enable briefly only.
LOG_DEBUG=false


# ─────────────────────────────────────────────────────────────────────────────
# 15. Worker (apps/worker/src/env.ts) — mặc định đã hợp lý / sane defaults
# ─────────────────────────────────────────────────────────────────────────────
# [BẮT BUỘC] Dải bucket (hex 0-255) của sequence scheduler mà instance xử lý.
# [REQUIRED] Sequence-scheduler bucket range handled by this instance.
SCHEDULER_BUCKET_RANGE=0-255

# [TUỲ CHỌN] Tinh chỉnh / tuning
# WEBHOOK_WORKER_CONCURRENCY=50
# INTEGRATION_WORKER_CONCURRENCY=10
# CHAT_WORKER_CONCURRENCY=5
# LOW_WORKER_CONCURRENCY=30
# AI_AGENT_WORKER_CONCURRENCY=5
# HEAVY_WORKER_CONCURRENCY=1
# NOTIFICATION_WORKER_CONCURRENCY=10
# BROADCAST_RECURRENCE_WORKER_CONCURRENCY=10
# PROFILE_SNAPSHOT_JOBS_PER_SECOND=10
# CALL_TRANSCRIBE_PER_MIN=10
# QUOTA_SYNC_INTERVAL_SECONDS=60
# QUOTA_MAC_ADMISSION=atomic
# CHAT_JOB_WAIT_TIMEOUT_MS=120000
# HEAVY_JOB_WAIT_TIMEOUT_MS=120000
# HEAVY_MAX_FILE_BYTES=52428800
# AUTOMATED_RESPONSE_TTL_SECONDS=2
# AUTOMATED_RESPONSE_DELAY_SECONDS=2
# Push notification qua Expo (app mobile) / Expo push for the mobile app
# EXPO_PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
# Snowflake place id 0-15 (mặc định ngẫu nhiên 1-15 mỗi process / random per process)
# SNOWFLAKE_PLACE_ID=


# ─────────────────────────────────────────────────────────────────────────────
# 16. MCP server (apps/mcp-server/src/env.ts) — chỉ khi bật profile "mcp"
# ─────────────────────────────────────────────────────────────────────────────
# Origin được phép gọi MCP qua trình duyệt / CORS origin for browser clients.
# MCP_CORS_ORIGIN=*
# MCP_SERVER_NAME=HiTechCloudOmnichannel MCP Server


# ─────────────────────────────────────────────────────────────────────────────
# 17. Giới hạn tài nguyên / Resource limits (docker-compose.prod.yml)
#     Mặc định cho server 8 GB RAM / defaults sized for an 8 GB server.
# ─────────────────────────────────────────────────────────────────────────────
# POSTGRES_MEM_LIMIT=2g
# REDIS_MEM_LIMIT=1g
# FILESYSTEM_MEM_LIMIT=1g
# BUILDER_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=4g
# REALTIME_MEM_LIMIT=1g
# MCP_MEM_LIMIT=512m
# PROXY_MEM_LIMIT=256m
# WORKER_NODE_OPTIONS=--max_old_space_size=1024


# ─────────────────────────────────────────────────────────────────────────────
# 18. Sao lưu / Backups (scripts/backup.sh)
# ─────────────────────────────────────────────────────────────────────────────
# Thư mục chứa bản sao lưu (tương đối với thư mục repo) / backup directory.
BACKUP_DIR=./backups
# Số ngày giữ bản sao lưu / days to keep backups.
BACKUP_RETENTION_DAYS=7
